# Jira Configuration
# Your Jira account email address
JIRA_EMAIL=your-email@example.com

# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Board ID (optional - not used with custom JQL query)
# Find your board ID in the URL when viewing a Jira board
# Example: https://your-domain.atlassian.net/jira/software/c/projects/PROJ/boards/123
# The board ID is the number at the end (123 in this example)
# JIRA_BOARD_ID=your_board_id_here

# Your Jira instance base URL
JIRA_BASE_URL=https://your-domain.atlassian.net

# Optional custom JQL.
# If empty, the app uses: updated >= -3650d ORDER BY updated DESC
# JIRA_JQL=project = PROJ AND statusCategory != Done ORDER BY created DESC

# Sentry API token with event:read scope
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Sentry organization slug and numeric project ID (both visible in the Sentry project URL)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT_ID=1234567890

# Optional server path stripped from Sentry issue titles
# SENTRY_PATH_PREFIX=/var/www/app

# Service Health checks: comma separated "Name|URL" pairs
HEALTH_CHECKS='My App|https://app.example.com/up,API|https://api.example.com/health'
